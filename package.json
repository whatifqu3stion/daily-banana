{
  "name": "the-daily-banana---comic-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "preview": "npm run start",
    "test:server": "node --test tests/server/*.test.mjs",
    "test:google-live": "playwright test -c playwright.google-live.config.ts",
    "test:e2e": "playwright install chromium && playwright test",
    "build:pages": "vite build --mode pages",
    "test:pages": "playwright test -c playwright.pages.config.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.4.21",
    "html-to-image": "^1.11.11",
    "postcss": "^8.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  }
}
